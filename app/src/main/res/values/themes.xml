<resources>
    <style name="Theme.SPV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/bg_root</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
    </style>

    <!-- Dark, rounded, on-brand dialogs (used for "add config", "add
         subscription", "delete subscription", etc.) instead of the default
         system AlertDialog, which renders with light/system chrome that
         clashes with the app's dark theme. -->
    <style name="Theme.SPV.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
        <item name="buttonBarPositiveButtonStyle">@style/SpvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/SpvDialogButton</item>
    </style>

    <style name="SpvDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/purple_primary</item>
    </style>
</resources>
