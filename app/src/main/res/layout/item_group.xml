<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/ivGroupIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_subscription"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintTop_toTopOf="@id/ivGroupIcon"
                app:layout_constraintBottom_toBottomOf="@id/ivGroupIcon"
                app:layout_constraintStart_toEndOf="@id/ivGroupIcon"
                app:layout_constraintEnd_toStartOf="@id/tvGroupExpand"
                tools:text="Turkey Subscription" />

            <TextView
                android:id="@+id/tvGroupMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvGroupName"
                app:layout_constraintStart_toStartOf="@id/tvGroupName"
                app:layout_constraintEnd_toEndOf="@id/tvGroupName"
                tools:text="5 configs • Subscription" />

            <ImageView
                android:id="@+id/tvGroupExpand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:layout_constraintTop_toTopOf="@id/tvGroupName"
                app:layout_constraintBottom_toBottomOf="@id/tvGroupName"
                app:layout_constraintStart_toEndOf="@id/tvGroupName"
                app:layout_constraintEnd_toStartOf="@id/btnGroupCopy"
                android:layout_marginEnd="4dp"
                android:padding="2dp" />

            <ImageButton
                android:id="@+id/btnGroupCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_copy"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvGroupExpand"
                app:layout_constraintEnd_toStartOf="@id/btnGroupRefresh" />

            <ImageButton
                android:id="@+id/btnGroupRefresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnGroupCopy"
                app:layout_constraintEnd_toStartOf="@id/btnGroupPing" />

            <ImageButton
                android:id="@+id/btnGroupPing"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bolt"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnGroupRefresh"
                app:layout_constraintEnd_toStartOf="@id/btnGroupDelete" />

            <ImageButton
                android:id="@+id/btnGroupDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnGroupPing"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layoutGroupUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/progressGroupUsage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="45"
                android:progressDrawable="@drawable/progress_usage_rounded" />

            <TextView
                android:id="@+id/tvGroupUsageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_gray"
                tools:text="9.2 GB از 20 GB مصرف شده  •  12 روز تا انقضا" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroupConfigs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_config" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
